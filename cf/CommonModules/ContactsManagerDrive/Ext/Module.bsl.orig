#Region Public

Procedure SetContactInformationKindProperties(Parameters) Export
	
	ContactsManager.SetContactInformationKindProperties(Parameters);
	
	If ValueIsFilled(Parameters.Name)
		And CommonClientServer.StructureProperty(Parameters, "ShowAlways", False) Then
		ContactInformationKind = ContactsManager.ContactInformationKindByName(Parameters.Name);
		If ValueIsFilled(ContactInformationKind) Then
			SetFlagShowInFormAlways(ContactInformationKind);
		EndIf;
	EndIf;
	
EndProcedure

Function ContactInformationKindParameters(ContactInformationKindOrType = Undefined) Export
	
	ContactInformationKindParameters = ContactsManager.ContactInformationKindParameters(ContactInformationKindOrType);
	ContactInformationKindParameters.Insert("ShowAlways", True);
	
	Return ContactInformationKindParameters;
	
EndFunction

Procedure OnInitialItemsFilling(LanguagesCodes, Items, TabularSections) Export
	
	Item = Items.Add();
	Item.PredefinedDataName = "UserWebpage";
	Item.Type = Enums.ContactInformationTypes.WebPage;
	
	Item.CanChangeEditMethod = True;
	Item.AllowMultipleValueInput   = True;
	Item.Parent = Catalogs.ContactInformationKinds.CatalogUsers;
	Item.IDForFormulas = "Webpage";
	Item.Used = True;
	Item.EditingOption = "InputFieldAndDialog";
	Item.AddlOrderingAttribute = 1;
	If Common.SubsystemExists("StandardSubsystems.NationalLanguageSupport") Then
		ModuleNativeLanguagesSupportServer = Common.CommonModule("NationalLanguageSupportServer");
		ModuleNativeLanguagesSupportServer.FillMultilanguageAttribute(Item, "Description", 
		"en = 'Webpage';", LanguagesCodes);
	Else
		Item.Description = NStr("en = 'Webpage';", Common.DefaultLanguageCode());
	EndIf;
	
#Region BusinessUnitsContactInformation
	
	Item = Items.Add(); 
	Item.PredefinedKindName = "CatalogBusinessUnits";
